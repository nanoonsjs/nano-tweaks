			<key>default</key><true/>
			<key>defaults</key><string>com.user.musicpill</string>
			<key>PostNotification</key><string>com.user.musicpill/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>footerText</key><string>Swipe left on the pill for the next song, right for the previous one.</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>Swipe to Skip</string>
			<key>key</key><string>swipe</string>
			<key>default</key><true/>
			<key>defaults</key><string>com.user.musicpill</string>
			<key>PostNotification</key><string>com.user.musicpill/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>iOS 26 Look</string>
			<key>footerText</key><string>Scrolling title for long song names in the pill. Album and playlist pages get a shuffle circle, white Play button and download circle. Top buttons get glass.</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>Scrolling Song Title</string>
			<key>key</key><string>marquee</string>
			<key>default</key><true/>
			<key>defaults</key><string>com.user.musicpill</string>
