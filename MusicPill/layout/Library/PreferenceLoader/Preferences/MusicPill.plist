<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>entry</key>
	<dict>
		<key>cell</key><string>PSLinkCell</string>
		<key>label</key><string>MusicPill</string>
		<key>icon</key><string>MusicPill.png</string>
	</dict>
	<key>title</key><string>MusicPill</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>Player Colors</string>
			<key>footerText</key><string>Automatic follows Settings > Accessibility > Display &amp; Text Size > Increase Contrast: pink star and artist on a black queue bar when it's on, white star and see-through queue bar when it's off.</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSegmentCell</string>
			<key>key</key><string>playerstyle</string>
			<key>default</key><integer>0</integer>
			<key>validValues</key><array><integer>0</integer><integer>1</integer><integer>2</integer></array>
			<key>validTitles</key><array><string>Automatic</string><string>Pink</string><string>White</string></array>
			<key>defaults</key><string>com.user.musicpill</string>
			<key>PostNotification</key><string>com.user.musicpill/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>footerText</key><string>Up Next shows the next song above the pill 10 seconds before the current one ends. Pin songs to Search from the player's ••• menu; hold a pin to remove it.</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>Up Next Preview</string>
			<key>key</key><string>upnext</string>
			<key>default</key><true/>
			<key>defaults</key><string>com.user.musicpill</string>
			<key>PostNotification</key><string>com.user.musicpill/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>Pinned Songs in Search</string>
			<key>key</key><string>pins</string>
			<key>default</key><true/>
			<key>defaults</key><string>com.user.musicpill</string>
			<key>PostNotification</key><string>com.user.musicpill/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>footerText</key><string>Both off by default. Album Color Glow tints the bottom pill and its circles with the playing album's color. Double-tap the cover in the player to favorite the song.</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>Album Color Glow</string>
			<key>key</key><string>albumglow</string>
			<key>default</key><false/>
			<key>defaults</key><string>com.user.musicpill</string>
			<key>PostNotification</key><string>com.user.musicpill/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>Double-Tap Cover to Favorite</string>
			<key>key</key><string>doubletapfav</string>
			<key>default</key><false/>
			<key>defaults</key><string>com.user.musicpill</string>
			<key>PostNotification</key><string>com.user.musicpill/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>footerText</key><string>On the full player, swipe the song title left for the next song or right for the previous one.</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>Swipe Title to Skip</string>
			<key>key</key><string>titleswipe</string>
			<key>default</key><true/>
			<key>defaults</key><string>com.user.musicpill</string>
			<key>PostNotification</key><string>com.user.musicpill/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>footerText</key><string>Off by default. Plays an album's animated cover in the player. Once you open an album with an animated cover and play it, the cover is saved, so it keeps playing every time after. Turning this off deletes the saved covers.</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>Animated Album Covers</string>
			<key>key</key><string>motioncovers</string>
			<key>default</key><false/>
			<key>defaults</key><string>com.user.musicpill</string>
			<key>PostNotification</key><string>com.user.musicpill/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>footerText</key><string>Changes should apply right away. If not, close Music from the app switcher and reopen it.</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>Rename Listen Now to Home</string>
