<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>entry</key>
	<dict>
		<key>cell</key><string>PSLinkCell</string>
		<key>label</key><string>MusicPill</string>
		<key>icon</key><string>MusicPill.png</string>
	</dict>
	<key>title</key><string>MusicPill</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>footerText</key><string>Changes should apply right away. If not, close Music from the app switcher and reopen it.</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>Rename Listen Now to Home</string>
			<key>key</key><string>rename</string>
			<key>default</key><true/>
			<key>defaults</key><string>com.user.musicpill</string>
			<key>PostNotification</key><string>com.user.musicpill/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>Round Now Playing Bar</string>
			<key>key</key><string>round</string>
			<key>default</key><true/>
			<key>defaults</key><string>com.user.musicpill</string>
			<key>PostNotification</key><string>com.user.musicpill/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>Collapse Bars When Scrolling</string>
			<key>key</key><string>collapse</string>
			<key>default</key><true/>
			<key>defaults</key><string>com.user.musicpill</string>
			<key>PostNotification</key><string>com.user.musicpill/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>footerText</key><string>Swipe left on the pill for the next song, right for the previous one.</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>Swipe to Skip</string>
			<key>key</key><string>swipe</string>
			<key>default</key><true/>
			<key>defaults</key><string>com.user.musicpill</string>
			<key>PostNotification</key><string>com.user.musicpill/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>iOS 26 Look</string>
			<key>footerText</key><string>Scrolling title for long song names in the pill. Album and playlist pages get a shuffle circle, white Play button and download circle. Top buttons get glass.</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>Scrolling Song Title</string>
			<key>key</key><string>marquee</string>
			<key>default</key><true/>
			<key>defaults</key><string>com.user.musicpill</string>
			<key>PostNotification</key><string>com.user.musicpill/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>iOS 26 Album Buttons</string>
			<key>key</key><string>album</string>
			<key>default</key><true/>
			<key>defaults</key><string>com.user.musicpill</string>
			<key>PostNotification</key><string>com.user.musicpill/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>Glass Top Buttons</string>
			<key>key</key><string>navglass</string>
			<key>default</key><true/>
			<key>defaults</key><string>com.user.musicpill</string>
			<key>PostNotification</key><string>com.user.musicpill/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>iOS 26 Queue Look</string>
			<key>key</key><string>queuelook</string>
			<key>default</key><true/>
			<key>defaults</key><string>com.user.musicpill</string>
			<key>PostNotification</key><string>com.user.musicpill/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>footerText</key><string>Shows a purple box with what MusicPill found and which settings it can read. Turn this on to test that the switches work.</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>Show Debug Info</string>
			<key>key</key><string>debug</string>
			<key>default</key><false/>
			<key>defaults</key><string>com.user.musicpill</string>
			<key>PostNotification</key><string>com.user.musicpill/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>footerText</key><string>Made by nano</string>
		</dict>
	</array>
</dict>
</plist>
